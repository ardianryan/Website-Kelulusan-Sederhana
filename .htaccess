RewriteEngine On

# Block access to sensitive files
<FilesMatch "^\.env|^\.git|^\.htaccess|composer\.json|composer\.lock">
    Order allow,deny
    Deny from all
</FilesMatch>

# Frontend Routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]
